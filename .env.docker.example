# Docker 环境变量配置
# 复制此文件为 .env 并填写真实值

# ============================================
# 应用配置
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# ============================================
# 数据库配置 (Docker Compose 自动配置)
# ============================================
# Docker Compose 会使用内部网络，无需修改
POSTGRES_DB=scripter
POSTGRES_USER=scripter_user
POSTGRES_PASSWORD=scripter_password_2025

# ============================================
# Casdoor 认证配置
# ============================================
# Docker 内部地址
CASDOOR_ENDPOINT=http://casdoor:8000

# 获取方式：
# 1. 启动 docker-compose up -d
# 2. 访问 http://localhost:8000
# 3. 登录 admin/admin123
# 4. 创建应用后复制 Client ID 和 Secret
CASDOOR_CLIENT_ID=your_client_id_here
CASDOOR_CLIENT_SECRET=your_client_secret_here

# 回调地址（根据实际部署修改）
CASDOOR_CALLBACK_URL=http://localhost:3000/api/auth/callback

# ============================================
# 智谱 AI 配置
# ============================================
# 获取方式：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here

# ============================================
# 可选配置
# ============================================
# 日志级别
LOG_LEVEL=info

# 会话密钥（生成随机字符串）
SESSION_SECRET=generate_random_string_here
