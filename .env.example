# ============================================
# Casdoor 认证配置
# ============================================

# Casdoor 服务地址 (开发环境使用 localhost，生产环境使用真实域名)
CASDOOR_ENDPOINT=http://localhost:8000

# OAuth 客户端配置 (从 Casdoor 应用详情页获取)
CASDOOR_CLIENT_ID=your_client_id_here
CASDOOR_CLIENT_SECRET=your_client_secret_here

# OAuth 回调地址 (必须与 Casdoor 应用配置一致)
# 开发环境:
CASDOOR_CALLBACK_URL=http://localhost:3000/api/auth/callback
# 生产环境:
# CASDOOR_CALLBACK_URL=https://scripter.art/api/auth/callback

# ============================================
# 会话安全配置
# ============================================

# 会话密钥 (用于 Cookie 签名和加密，至少 32 字符)
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=your_session_secret_at_least_32_characters_long_change_this_in_production

# ============================================
# 数据库配置
# ============================================

# PostgreSQL 连接字符串
# 开发环境:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scripter
# 或者使用 Docker:
# DATABASE_URL=postgresql://user:password@host.docker.internal:5432/scripter

# ============================================
# 智谱 AI 配置
# ============================================

# 智谱 AI API 密钥 (从 https://open.bigmodel.cn/ 获取)
ZHIPU_API_KEY=your_zhipu_api_key_here

# ============================================
# 应用配置
# ============================================

# 应用 URL (开发环境)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 生产环境:
# NEXT_PUBLIC_APP_URL=https://scripter.art

# ============================================
# 可选配置
# ============================================

# Node 环境 (development | production)
NODE_ENV=development

# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info

# 开发模式：绕过认证 (仅用于开发测试)
# BYPASS_AUTH=true

