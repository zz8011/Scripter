        {
          "phase": "planning",
          "agents": ["scientific-dev"]
        },
        {
          "phase": "implementation",
          "agents": ["ui-component-agent", "data-agent"],
          "parallel": true
        },
        {
          "phase": "ai_integration",
          "agents": ["ai-integration-agent"],
          "optional": true
        },
        {
          "phase": "testing",
          "agents": ["integration-agent"]
        },
        {
          "phase": "review",
          "agents": ["scientific-dev"]
        }
      ]
    },
